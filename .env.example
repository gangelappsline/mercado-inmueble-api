###########################################################################
# MERCADO INMUEBLE API · Variables de entorno documentadas
# Copia este archivo a .env y ejecuta: php artisan key:generate
###########################################################################

# ─── Aplicación ───────────────────────────────────────────────────────────
APP_NAME="Mercado Inmueble"
APP_ENV=local                       # local | staging | production
APP_KEY=
APP_DEBUG=true                      # false SIEMPRE en producción
APP_URL=http://localhost:8000
APP_VERSION=1.0.0                   # Se publica en la documentación OpenAPI
APP_TIMEZONE=America/La_Paz
APP_FORCE_HTTPS=false               # true detrás de balanceador con TLS

# ─── Localización (la API responde en español) ────────────────────────────
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

# ─── Dominio de negocio ───────────────────────────────────────────────────
MERCADO_PAIS=Bolivia
MERCADO_MONEDA_POR_DEFECTO=BOB
MERCADO_COMISION_PORCENTAJE=3.0     # % usado en el reporte de ingresos
MERCADO_CATALOGO_CACHE_SEGUNDOS=3600
MERCADO_PAGINACION_POR_DEFECTO=15
MERCADO_PAGINACION_MAXIMA=100
MERCADO_GEO_LATITUD=-16.5000000     # Centro por defecto de la búsqueda por cercanía
MERCADO_GEO_LONGITUD=-68.1500000
MERCADO_GEO_RADIO_MAX_KM=100

# ─── Base de datos (MySQL 8 en producción) ────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mercado_inmueble
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
# Al correr los tests se usa SQLite en memoria (ver phpunit.xml)
# db:seed usa datos de demostración; nunca ejecutes --seed en producción.

# ─── Passport (OAuth2) ────────────────────────────────────────────────────
# Genera las llaves con: php artisan mercado:instalar
# Para despliegues en contenedores puedes inyectarlas como variables (base64).
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=
PASSPORT_TOKEN_TTL_MINUTOS=120        # Vigencia del access token
PASSPORT_REFRESH_TTL_DIAS=30          # Vigencia del refresh token
PASSPORT_PERSONAL_TOKEN_TTL_DIAS=30   # Vigencia de tokens personales (app móvil)
# Credenciales del cliente "first-party" usadas por /api/v1/auth/refresh.
# Se rellenan automáticamente al ejecutar: php artisan mercado:instalar
PASSPORT_CLIENT_ID=
PASSPORT_CLIENT_SECRET=
PASSPORT_PERSONAL_CLIENT_ID=
DOCS_ALLOWED_EMAILS=              # correos con acceso a /docs/api fuera de local
DOCS_ALLOWED_IPS=                 # IPs con acceso a /docs/api fuera de local

# ─── Archivos y medios ────────────────────────────────────────────────────
FILESYSTEM_DISK=public
MEDIA_DISCO_FOTOS=public            # disk local público (storage/app/public)
MEDIA_DISCO_VIDEOS=private          # disk privado; usa 's3' en producción
MEDIA_MAX_FOTOS_POR_PROPIEDAD=20
MEDIA_MAX_PESO_FOTO_KB=5120      # 5 MB por foto
MEDIA_MAX_PESO_VIDEO_KB=102400      # 100 MB por video
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─── Correo (notificaciones transaccionales) ──────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="no-reply@mercadoinmueble.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_NOREPLY_ADDRESS="no-reply@mercadoinmueble.com"
MERCADO_EMAIL_ADMIN="soporte@mercadoinmueble.com"

# ─── Colas (los correos y notificaciones se encolan) ──────────────────────
QUEUE_CONNECTION=database
# En producción: QUEUE_CONNECTION=redis y ejecuta `php artisan queue:work`

# ─── Caché / sesiones (catálogos y rate limiting) ─────────────────────────
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── CORS ─────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=*                       # En producción: dominio del front
CORS_SUPPORTS_CREDENTIALS=false

# ─── Documentación OpenAPI (Scramble) ─────────────────────────────────────
SCRAMBLE_DEV_TOOLS=true                      # Solo en local
# Acceso a /docs/api fuera de local: correos e IPs permitidos (separados por coma)
DOCS_ALLOWED_EMAILS=
DOCS_ALLOWED_IPS=

# ─── Panel de administración (rol `administrador`) ────────────────────────
# Cuenta que crea `php artisan mercado:instalar` (o `mercado:crear-admin`).
# Sin ADMIN_PASSWORD el instalador genera una contraseña aleatoria y la
# imprime una única vez. Estas cuentas nunca se crean por el registro público.
ADMIN_CREAR_EN_INSTALACION=true
ADMIN_EMAIL="admin@mercadoinmueble.com"
ADMIN_NOMBRE="Administrador Mercado Inmueble"
ADMIN_PASSWORD=

# ─── Auditoría (spatie/laravel-activitylog) ───────────────────────────────
ACTIVITY_LOGGER_ENABLED=true
ACTIVITY_LOGGER_RETENCION_DIAS=365

# ─── Logs ─────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
LOG_DEPRECATIONS_CHANNEL=null

# ─── Rate limiting (peticiones por minuto) ────────────────────────────────
RATE_LIMIT_INVITADO=60
RATE_LIMIT_CLIENTE=120
RATE_LIMIT_VENDEDOR=240
RATE_LIMIT_INMOBILIARIA=480
RATE_LIMIT_ADMINISTRADOR=600   # Panel /api/v1/admin (rol administrador)
RATE_LIMIT_AUTH=10             # /auth/login, /auth/forgot-password
RATE_LIMIT_CONTACTO=5          # Formulario público de contacto
RATE_LIMIT_DOCS=60
